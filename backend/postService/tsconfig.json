{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "../..",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@libs/*": ["../../libs/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../types/**/*.ts",
    "../../libs/src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
