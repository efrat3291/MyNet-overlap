{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@libs/*": ["../../libs/src/*"],
    },
  },
  "include": ["src/**/*.ts", "../types/**/*.ts", "../../libs/src/types/user/user.type.ts", "../../libs/src/types/post/post.type.ts"],
  "exclude": ["node_modules", "dist"]
}
